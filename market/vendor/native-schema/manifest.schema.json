{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://go.dshtui.com/schema/plugin-kit/v1/manifest.schema.json",
  "title": "dsh-go native plugin manifest (package.json \"dshGo\"), protocol v1",
  "description": "docs/design/native-plugins-protocol.md §1. Unknown keys and surfaces are ignored with a warning by the bridge, so they are allowed here; the SDK check reports them. Serialized size <= 16 KiB.",
  "type": "object",
  "required": [
    "v",
    "contributes"
  ],
  "properties": {
    "v": {
      "const": 1,
      "description": "Protocol major version."
    },
    "minApp": {
      "$ref": "#/$defs/semver",
      "description": "Lowest dsh-go app version that may render this plugin natively."
    },
    "title": {
      "$ref": "#/$defs/text",
      "description": "Display name, <= 24 characters after locale resolution."
    },
    "icon": {
      "$ref": "#/$defs/iconName"
    },
    "wants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "draft",
          "clipboard",
          "message"
        ]
      },
      "description": "Content attached to taps: draft/clipboard on composer.actions and composer.tools, message on message.actions."
    },
    "assets": {
      "$ref": "#/$defs/relativePath",
      "description": "Image directory served by GET /dsh-go/v1/assets/<pkg>/<path>."
    },
    "contributes": {
      "type": "object",
      "properties": {
        "composer.actions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/action",
            "properties": {
              "label": {
                "$ref": "#/$defs/text",
                "description": "<= 10 characters"
              }
            }
          }
        },
        "message.actions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/action",
            "properties": {
              "label": {
                "$ref": "#/$defs/text",
                "description": "<= 12 characters"
              }
            }
          }
        },
        "composer.strip": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/strip"
          }
        },
        "panels": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/panel"
          }
        },
        "media": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "manifest.schema.json#/$defs/id"
              }
            }
          }
        },
        "micro": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "manifest.schema.json#/$defs/id"
              }
            }
          }
        },
        "overlays": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "anyOf": [
              {
                "required": [
                  "channel"
                ]
              },
              {
                "required": [
                  "text"
                ]
              }
            ],
            "properties": {
              "id": {
                "$ref": "manifest.schema.json#/$defs/id"
              },
              "channel": {
                "$ref": "manifest.schema.json#/$defs/id"
              },
              "text": {
                "type": "string",
                "maxLength": 240
              }
            }
          }
        },
        "composer.tools": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "session.actions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/action",
            "properties": {
              "label": {
                "$ref": "#/$defs/text",
                "description": "<= 12 characters"
              }
            }
          }
        },
        "turn.note": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "audio",
          "voice",
          "micro",
          "overlay",
          "files"
        ]
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$",
      "description": "Unique across all contributions of one plugin."
    },
    "iconName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "description": "App icon name; unknown names render a generic plugin icon."
    },
    "text": {
      "description": "A string, or a locale -> string map resolved by the bridge (exact, language, en, zh, first).",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}([_-][A-Za-z0-9]{2,8})*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(\\./)?[^/\\\\][^\\\\]*$",
      "description": "Relative to the package directory; must stay inside it."
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "icon": {
          "$ref": "#/$defs/iconName"
        },
        "effect": {
          "description": "Static effect(s) executed by the app without invoke.",
          "oneOf": [
            {
              "$ref": "invoke.schema.json#/$defs/staticEffect"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "invoke.schema.json#/$defs/staticEffect"
              }
            }
          ]
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "audio",
              "voice",
              "micro",
              "overlay",
              "files"
            ]
          }
        }
      }
    },
    "strip": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "icon": {
          "$ref": "#/$defs/iconName"
        },
        "text": {
          "$ref": "#/$defs/text",
          "description": "Static fallback, <= 24 characters."
        },
        "panel": {
          "$ref": "#/$defs/id",
          "description": "Own panel opened on tap."
        }
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text",
          "description": "<= 16 characters"
        },
        "icon": {
          "$ref": "#/$defs/iconName"
        },
        "placement": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "session.tab",
              "features",
              "chat.panel",
              "plugin"
            ]
          },
          "default": [
            "session.tab"
          ]
        },
        "view": {
          "$ref": "#/$defs/relativePath",
          "description": "Static view JSON file (<= 32 KiB, view.schema.json)."
        },
        "micro": {
          "$ref": "manifest.schema.json#/$defs/id"
        },
        "presentation": {
          "enum": [
            "page",
            "sheet"
          ],
          "description": "How the panel opens: a pushed page (default) or a sheet."
        }
      }
    },
    "tool": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text",
          "description": "<= 8 characters"
        },
        "icon": {
          "$ref": "#/$defs/iconName"
        },
        "effect": {
          "description": "Static effect(s) executed by the app without invoke.",
          "oneOf": [
            {
              "$ref": "invoke.schema.json#/$defs/staticEffect"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "invoke.schema.json#/$defs/staticEffect"
              }
            }
          ]
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "audio",
              "voice",
              "micro",
              "overlay",
              "files"
            ]
          }
        },
        "panel": {
          "$ref": "#/$defs/id",
          "description": "Opens this plugin's panel. Write panel or effect, not both."
        }
      },
      "if": {
        "required": [
          "panel"
        ]
      },
      "then": {
        "properties": {
          "effect": false
        }
      }
    }
  }
}
